flowchart TB
    Supporter["Supporter's browser\nRaffle site · pays through the Stripe Payment Element"]
    Operator["Operator\nIAM credentials · aws lambda invoke"]
    StripeEvents["Stripe webhooks\ncharge.succeeded · charge.refunded · payment_intent.payment_failed"]
    StripeApi["Stripe API\napi.stripe.com · Customers · PaymentIntents · Refunds · Charges"]

    subgraph AWS["AWS · eu-west-2 · always-free tier"]
        subgraph Functions["Lambda · Rust 1.98 · arm64 · provided.al2023"]
            Api["api\nfunction URL · GET /raffles/current · POST /raffles/…/orders"]
            Webhook["stripe-webhook\nfunction URL · HMAC signature · gapless ticket allocation"]
            Charge["subscription-charge\nhourly · off-session charge when a raffle opens"]
            Reconcile["reconcile\ndaily 06:00 UTC · ledger, charges, subscribers"]
            Canary["canary\nevery 5 minutes · probes the browse endpoint"]
            Draw["draw-run\nadmin invoked · CSPRNG winners, resumable"]
            Admin["admin\nadmin invoked · raffles, prizes, erasure"]
        end
        Events["EventBridge rules\nrate(5 minutes) · rate(1 hour) · cron 06:00 UTC"]
        Table["DynamoDB raffle-prod\nsingle table · GSI1 · GSI2 · 25 provisioned units, always-free"]
        Logs["CloudWatch Logs + Metrics\nJSON logs of all seven functions · EMF metrics · Http5xx filter"]
        Alerts["SNS raffle-prod-alerts\n10 standard alarms · email subscription"]
    end

    Supporter -->|"HTTPS"| Api
